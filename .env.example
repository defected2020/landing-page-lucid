# ── Internal admin (/admin) ──────────────────────────────────────────
# Who can sign in. name:password pairs, comma separated. Names are
# case-insensitive and show up as the author on documents and files.
ADMIN_USERS=george:change-me,teammate:change-me-too

# Or a single shared login (user name "admin"). ADMIN_USERS wins if both set.
# ADMIN_PASSWORD=

# Signs the session cookie. Any long random string, e.g. `openssl rand -hex 32`.
# Optional locally; set it in production so sessions survive password edits.
ADMIN_SESSION_SECRET=

# Storage. Leave unset locally: documents and files go to ./.admin-data/.
# On Vercel: Storage → Create → Blob, connect it to this project, and this
# variable is injected automatically (private blobs, streamed via /api/admin).
# BLOB_READ_WRITE_TOKEN=

# ── SEO ─────────────────────────────────────────────────────────────
# GOOGLE_SITE_VERIFICATION=
